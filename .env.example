# Environment Variables for Local Development
# Story 0.2: Local Development Environment - Docker Compose
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Start Supabase local stack: `npx supabase start`
# 3. Copy the SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY from the output
# 4. Generate secure random keys for JWT_SECRET, ADMIN_JWT_SECRET, N8N_PASSWORD, N8N_ENCRYPTION_KEY
# 5. Start services: `docker-compose up`

# ==============================================================================
# Supabase Configuration (Local Development)
# ==============================================================================

# Supabase API URL (local)
SUPABASE_URL=http://localhost:54321

# Supabase Anonymous Key
# Get this from `npx supabase start` output
# Look for: "anon key: eyJh..."
SUPABASE_ANON_KEY=your-supabase-anon-key-from-supabase-start

# Supabase Service Role Key (has admin privileges)
# Get this from `npx supabase start` output
# Look for: "service_role key: eyJh..."
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-from-supabase-start

# Supabase JWT Secret (for verifying JWTs)
# Get this from `npx supabase start` output
# Look for: "JWT secret: super-secret..."
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-supabase-start

# ==============================================================================
# Database Configuration
# ==============================================================================

# PostgreSQL Connection String (Supabase local database)
# IMPORTANT: Use app_user for application queries (RLS enforcement)
# Use postgres only for migrations and admin tasks
DATABASE_URL=postgresql://app_user:app_user_dev@localhost:54322/postgres

# ==============================================================================
# Next.js Public Environment Variables
# ==============================================================================

# These variables are exposed to the browser (prefixed with NEXT_PUBLIC_)
# Used by apps/web and apps/admin

# Supabase URL (same as above, but for Next.js)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase Anonymous Key (for client-side auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-from-supabase-start

# IMPORTANT: Never expose the service role key through NEXT_PUBLIC_ variables.
# Keep SUPABASE_SERVICE_ROLE_KEY server-side only.

# ==============================================================================
# Authentication & Security
# ==============================================================================

# JWT Secret for application-level authentication
# Generate with: `openssl rand -base64 32`
JWT_SECRET=your-generated-jwt-secret-here

# Admin JWT Secret (separate from tenant JWT for security)
# Generate with: `openssl rand -base64 32`
ADMIN_JWT_SECRET=your-generated-admin-jwt-secret-here

# ==============================================================================
# n8n Workflow Automation
# ==============================================================================

# n8n Basic Auth Username
N8N_BASIC_AUTH_USER=admin

# n8n Basic Auth Password
# Choose a secure password
N8N_PASSWORD=your-secure-n8n-password

# n8n Encryption Key (for storing credentials securely)
# Generate with: `openssl rand -hex 32`
N8N_ENCRYPTION_KEY=your-generated-n8n-encryption-key

# ==============================================================================
# Application Configuration
# ==============================================================================

# Node environment
NODE_ENV=development

# API Port (internal to container, external is 3001)
PORT=3000

# ==============================================================================
# Transactional Email (Story 1.4)
# ==============================================================================

# Resend API key used by the API invite flow only
RESEND_API_KEY=your-resend-api-key

# Verified sender address used for invitation emails
RESEND_FROM_EMAIL=no-reply@example.com

# ==============================================================================
# AI Services (Optional - for future stories)
# ==============================================================================

# OpenAI API Key (required for LangGraph/AI features)
# OPENAI_API_KEY=sk-your-openai-api-key

# ==============================================================================
# Monitoring & Observability (Story 0.4)
# ==============================================================================

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# Grafana Cloud Loki (Structured Logs)
# HOW TO ENABLE IN DEVELOPMENT:
# 1. Create a free Grafana Cloud account: https://grafana.com/auth/sign-up/create-user
# 2. Go to "Connections" > "Add new connection" > "Hosted logs"
# 3. Copy your Loki endpoint, username, and API key
# 4. Uncomment and fill in the values below
# 5. Restart the API container
# 6. Logs will now ship to Grafana Cloud Loki within 30 seconds
#
# LOKI_HOST=https://logs-prod-XXX.grafana.net
# LOKI_USERNAME=your-loki-user-id
# LOKI_PASSWORD=your-loki-api-key

# Grafana Cloud Prometheus (Metrics Push)
# HOW TO ENABLE IN DEVELOPMENT:
# 1. In Grafana Cloud, go to "Connections" > "Add new connection" > "Hosted metrics"
# 2. Copy your Prometheus remote-write endpoint, username, and API key
# 3. Uncomment and fill in the values below
# 4. Restart the API container
# 5. Metrics will push to Grafana Cloud every 15 seconds
#
# Note: PROMETHEUS_PUSH_GATEWAY should be the remote-write endpoint (ends with /api/prom/push)
# PROMETHEUS_PUSH_GATEWAY=https://prometheus-prod-XXX-prod-us-central-0.grafana.net/api/prom/push
# PROMETHEUS_USERNAME=your-prometheus-user-id
# PROMETHEUS_PASSWORD=your-prometheus-api-key

# Slack Webhook for Alerting (Optional - configure alert in Grafana Cloud UI)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==============================================================================
# Development Tools
# ==============================================================================

# Enable/disable features for development
# CHOKIDAR_USEPOLLING=true  # Uncomment if file watching is slow in Docker
