# Environment Variables for Local Development
# Story 0.2: Local Development Environment - Docker Compose
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Start Supabase local stack: `npx supabase start`
# 3. Copy the SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY from the output
# 4. Generate secure random keys for JWT_SECRET, ADMIN_JWT_SECRET, N8N_PASSWORD, N8N_ENCRYPTION_KEY
# 5. Start services: `docker-compose up`

# ==============================================================================
# Supabase Configuration (Local Development)
# ==============================================================================

# Supabase API URL (local)
SUPABASE_URL=http://localhost:54321

# Supabase Anonymous Key
# Get this from `npx supabase start` output
# Look for: "anon key: eyJh..."
SUPABASE_ANON_KEY=your-supabase-anon-key-from-supabase-start

# Supabase Service Role Key (has admin privileges)
# Get this from `npx supabase start` output
# Look for: "service_role key: eyJh..."
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-from-supabase-start

# ==============================================================================
# Database Configuration
# ==============================================================================

# PostgreSQL Connection String (Supabase local database)
# Default credentials: postgres/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ==============================================================================
# Next.js Public Environment Variables
# ==============================================================================

# These variables are exposed to the browser (prefixed with NEXT_PUBLIC_)
# Used by apps/web and apps/admin

# Supabase URL (same as above, but for Next.js)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase Anonymous Key (for client-side auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-from-supabase-start

# Supabase Service Role Key (admin app only)
# IMPORTANT: Never expose this in the tenant web app!
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-from-supabase-start

# ==============================================================================
# Authentication & Security
# ==============================================================================

# JWT Secret for application-level authentication
# Generate with: `openssl rand -base64 32`
JWT_SECRET=your-generated-jwt-secret-here

# Admin JWT Secret (separate from tenant JWT for security)
# Generate with: `openssl rand -base64 32`
ADMIN_JWT_SECRET=your-generated-admin-jwt-secret-here

# ==============================================================================
# n8n Workflow Automation
# ==============================================================================

# n8n Basic Auth Username
N8N_BASIC_AUTH_USER=admin

# n8n Basic Auth Password
# Choose a secure password
N8N_PASSWORD=your-secure-n8n-password

# n8n Encryption Key (for storing credentials securely)
# Generate with: `openssl rand -hex 32`
N8N_ENCRYPTION_KEY=your-generated-n8n-encryption-key

# ==============================================================================
# Application Configuration
# ==============================================================================

# Node environment
NODE_ENV=development

# API Port (internal to container, external is 3001)
PORT=3000

# ==============================================================================
# AI Services (Optional - for future stories)
# ==============================================================================

# OpenAI API Key (required for LangGraph/AI features)
# OPENAI_API_KEY=sk-your-openai-api-key

# ==============================================================================
# Monitoring & Observability (Optional - Story 0.4)
# ==============================================================================

# Grafana Cloud Loki (Logs)
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USER=your-loki-user-id
# GRAFANA_CLOUD_LOKI_API_KEY=your-loki-api-key

# Grafana Cloud Prometheus (Metrics)
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-XXX.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROMETHEUS_USER=your-prometheus-user-id
# GRAFANA_CLOUD_PROMETHEUS_API_KEY=your-prometheus-api-key

# Logging Level
LOG_LEVEL=info

# ==============================================================================
# Development Tools
# ==============================================================================

# Enable/disable features for development
# CHOKIDAR_USEPOLLING=true  # Uncomment if file watching is slow in Docker
